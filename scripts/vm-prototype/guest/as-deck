#!/bin/sh
# Run a command as the desktop user inside the running sway session.
u=$(id -u deck); r=/run/user/$u
w=$(cd $r && ls wayland-* 2>/dev/null | grep -v lock | head -1)
s=$(ls $r/sway-ipc.*.sock 2>/dev/null | head -1)
exec runuser -u deck -- env XDG_RUNTIME_DIR=$r WAYLAND_DISPLAY=$w SWAYSOCK=$s "$@"
