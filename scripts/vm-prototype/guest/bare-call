#!/usr/bin/env python3
"""Relay one bare-mcp request to the session bare-mcp. Runs as a Deck executor command.

Probe: `bare-call --ready [seconds]` prints one JSON line (see ready()).
argv[1] is {"method": "tools/list" | "tools/call", "params": {...}, "timeout": seconds}.
The reply goes to $DECK_OUT/reply.json, so the host fetches it as a checked artifact.
Files that the reply names (screenshots, downloads) are copied next to it.
Paths of the guest never reach the model: the host maps them to its own artifact paths.
"""
import json, os, re, shutil, stat, sys, time, uuid

MAX_FILE = 8 << 20
MAX_COPIES = 12
PROTOCOL = "2025-06-18"
STATE_NAME = re.compile(r"[A-Za-z0-9_-]{1,64}")


def session_dir():
    return os.path.join(os.environ["XDG_RUNTIME_DIR"], "bare")


class Rpc:
    def __init__(self, d):
        self.d = d

    def call(self, method, params=None, wait=60.0, notify=False):
        rid = None if notify else int(time.time() * 1000) * 1000 + uuid.uuid4().int % 1000
        msg = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            msg["params"] = params
        if rid is not None:
            msg["id"] = rid
        pos = os.path.getsize(os.path.join(self.d, "out"))
        # Non-blocking: a FIFO with no reader (bare-mcp gone) fails with ENXIO instead of hanging.
        fd = os.open(os.path.join(self.d, "in"), os.O_WRONLY | os.O_NONBLOCK)
        try:
            os.write(fd, (json.dumps(msg) + "\n").encode())
        finally:
            os.close(fd)
        if rid is None:
            return None
        end = time.monotonic() + wait
        while time.monotonic() < end:
            with open(os.path.join(self.d, "out"), "rb") as f:
                f.seek(pos)
                buf = f.read()
            for line in buf.split(b"\n"):
                if line.strip():
                    try:
                        v = json.loads(line)
                    except ValueError:
                        continue
                    if v.get("id") == rid:
                        return v
            time.sleep(0.05)
        raise TimeoutError(f"bare-mcp did not answer {method}")


def handshake(rpc, d, wait=30):
    marker = os.path.join(d, "init")
    if os.path.exists(marker):
        return
    rpc.call("initialize", {"protocolVersion": PROTOCOL, "capabilities": {}, "clientInfo": {"name": "deck-relay", "version": "1"}}, wait=wait)
    rpc.call("notifications/initialized", notify=True)
    open(marker, "w").close()


def ready(wait):
    """Read-only readiness probe: print one JSON line. Exit 0 only when bare-mcp answers tools/list.

    It sends initialize (once per session) and tools/list. It acts on no page and reads no credential.
    It prints stable reason codes, never guest output. It starts no session.
    """
    def out(**kw):
        print(json.dumps(kw))
        return 0 if kw.get("ready") else 3

    d = session_dir()
    try:
        os.close(os.open(os.path.join(d, "in"), os.O_WRONLY | os.O_NONBLOCK))  # a reader must exist
    except OSError:
        return out(ready=False, reason="no_session")
    try:
        rpc = Rpc(d)
        end = time.monotonic() + wait
        handshake(rpc, d, wait)
        v = rpc.call("tools/list", {}, wait=max(0.1, end - time.monotonic()))
    except TimeoutError:
        return out(ready=False, reason="no_answer")
    except Exception:
        return out(ready=False, reason="error")
    tools = (v.get("result") or {}).get("tools")
    if "error" in v or not isinstance(tools, list) or not tools:
        return out(ready=False, reason="bad_reply")
    try:
        with open(os.path.expanduser("~/.local/state/deck-executor/identity.json")) as f:
            ident = json.load(f)
        bot, guest = ident["bot_id"], ident["guest_id"]
    except (OSError, ValueError, KeyError, TypeError):
        return out(ready=False, reason="no_identity")
    return out(ready=True, tools=len(tools), bot_id=bot, guest_id=guest)


def state_file(name):
    """Path of the one shared browser profile saved under `name`. Raises ValueError on an unsafe name or path.

    The directories must be real, owned by this user, and private (no group or other bits) from `deck` down.
    An existing file must be a regular file with one link, owned by this user, mode 0600. Nothing is repaired.
    A missing file is left to bare, which creates it with mode 0600. This is not a defense against a hostile guest shell (D33).
    """
    if not (isinstance(name, str) and STATE_NAME.fullmatch(name)):
        raise ValueError("browser state name not allowed: use 1 to 64 letters, digits, _ or -")
    uid = os.geteuid()
    path = os.path.expanduser("~")
    for i, part in enumerate((".local", "state", "deck", "browser")):
        path = os.path.join(path, part)
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            os.mkdir(path, 0o700)
            st = os.lstat(path)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid or (i >= 2 and st.st_mode & 0o077):
            raise ValueError("browser state directory is not a private directory of this user")
    path = os.path.join(path, name + ".state")
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return path
    if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_nlink != 1 or stat.S_IMODE(st.st_mode) != 0o600:
        raise ValueError("browser state file is not a private regular file of this user")
    return path


def prepare(params, out, workspace):
    """Fix the arguments that Deck controls. The model's values for them were removed on the host."""
    args = dict(params.get("arguments") or {})
    name = params.get("name")
    if name == "screenshot":
        args["path"] = os.path.join(out, f"shot-{uuid.uuid4().hex[:8]}.png")
    secrets = os.path.expanduser("~/.config/deck/secrets.env")
    if name in ("open", "ensure_session") and os.path.isfile(secrets):
        args["secrets_file"] = secrets
    # One shared profile: the saved name picks the file. The model's `file` is replaced.
    if name in ("save_state", "ensure_session"):
        args["file"] = state_file(args.get("name"))
    elif name == "open" and args.get("state") is not None:
        args["file"] = state_file(args["state"])
    if name == "open":
        dl = os.path.join(workspace, "downloads")
        os.makedirs(dl, exist_ok=True)
        args["downloads_dir"] = dl
    if isinstance(args.get("files"), list):
        root = os.path.realpath(workspace)
        real = []
        for f in args["files"]:
            p = os.path.realpath(os.path.join(root, f)) if isinstance(f, str) else ""
            if not (p.startswith(root + os.sep) and os.path.isfile(p)):
                raise ValueError(f"upload path not allowed: {f}: give a path relative to the workspace")
            real.append(p)
        args["files"] = real
    return {**params, "arguments": args}


def collect(report, out, since, workspace):
    """Copy files that the report names, and new downloads, into $DECK_OUT. Returns {guest path: artifact name}."""
    paths = []
    if isinstance(report, dict):
        for st in report.get("steps") or []:
            n = st.get("note") if isinstance(st, dict) else None
            if isinstance(n, str) and n.startswith("/"):
                paths.append(n)
    dl = os.path.join(workspace, "downloads")
    if os.path.isdir(dl):
        for n in sorted(os.listdir(dl)):
            p = os.path.join(dl, n)
            if os.path.isfile(p) and os.stat(p).st_mtime >= since:
                paths.append(p)
    files = {}
    for p in paths:
        if len(files) >= MAX_COPIES or p in files or os.path.dirname(p) == out:
            continue
        try:
            if os.path.islink(p) or not os.path.isfile(p) or os.path.getsize(p) > MAX_FILE:
                continue
            base = "".join(c if c.isalnum() or c in "._-" else "_" for c in os.path.basename(p)).lstrip(".-") or "file"
            name = f"{len(files)}-{base}"[:128]
            shutil.copyfile(p, os.path.join(out, name))
            files[p] = name
        except OSError:
            continue
    return files


def main():
    if sys.argv[1:2] == ["--ready"]:
        sys.exit(ready(float(sys.argv[2]) if len(sys.argv) > 2 else 8.0))
    req = json.loads(sys.argv[1])
    out = os.environ["DECK_OUT"]
    workspace = os.environ["DECK_WORKSPACE"]
    d = session_dir()
    reply = {"ok": False, "out": out}
    try:
        if not os.path.exists(os.path.join(d, "in")):
            raise RuntimeError("bare-mcp is not running in the desktop session")
        rpc = Rpc(d)
        handshake(rpc, d)
        timeout = float(req.get("timeout", 120))
        method, params = req["method"], req.get("params") or {}
        if method == "tools/call":
            params = prepare(params, out, workspace)
        since = time.time() - 1
        v = rpc.call(method, params, wait=timeout)
        if "error" in v:
            reply.update(error=f"bare-mcp error: {v['error']}")
        else:
            reply.update(ok=True, result=v.get("result"))
            if method == "tools/call":
                text = (v.get("result", {}).get("content") or [{}])[0].get("text", "")
                try:
                    report = json.loads(text)
                except ValueError:
                    report = None
                reply["files"] = collect(report, out, since, workspace)
    except Exception as e:  # the host reads the error from the reply
        reply.update(ok=False, error=f"{type(e).__name__}: {e}")
    with open(os.path.join(out, "reply.json"), "w") as f:
        json.dump(reply, f)


if __name__ == "__main__":
    main()
